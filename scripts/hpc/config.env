# Configuration for scripts/hpc/download_all.sh. Override any value by exporting
# it before running, e.g.  DATA_DIR=/scratch/me/rdv bash scripts/hpc/download_all.sh

# Where everything lands (~50 GB with the defaults below). Prefer scratch/work space.
DATA_DIR="${DATA_DIR:-${SCRATCH:-$HOME}/rare_disease_variants/data}"

# Python with the packages in scripts/hpc/requirements.txt installed.
PYTHON="${PYTHON:-python3}"

# Parallel workers for gnomAD slicing and AlphaFold downloads.
WORKERS="${WORKERS:-8}"

# ClinVar monthly archives used to reconstruct label history (RQ1).
# Quarterly snapshots are enough for the event-study design; set to
# "01,02,03,04,05,06,07,08,09,10,11,12" for every month (~3x the disk).
CLINVAR_ARCHIVE_FROM="${CLINVAR_ARCHIVE_FROM:-2017}"
CLINVAR_ARCHIVE_MONTHS="${CLINVAR_ARCHIVE_MONTHS:-01,04,07,10}"
CLINVAR_ARCHIVE_KINDS="${CLINVAR_ARCHIVE_KINDS:-variant_summary,submission_summary}"

# gnomAD v4.1 joint (exomes + genomes) sites VCFs, read remotely by tabix.
# (Assigned with an if: a "}" inside ${VAR:-default} would end the expansion early.)
if [[ -z "${GNOMAD_VCF_TEMPLATE:-}" ]]; then
  GNOMAD_VCF_TEMPLATE='https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/joint/gnomad.joint.v4.1.sites.{chrom}.vcf.bgz'
fi

# Conservation tracks (large bigWigs). Verify URLs on hgdownload if they 404.
PHYLOP241_URL="${PHYLOP241_URL:-https://hgdownload.soe.ucsc.edu/goldenPath/hg38/cactus241way/cactus241way.phyloP.bw}"
PHYLOP100_URL="${PHYLOP100_URL:-https://hgdownload.soe.ucsc.edu/goldenPath/hg38/phyloP100way/hg38.phyloP100way.bw}"

# ProteinGym DMS substitutions (check the current release on proteingym.org).
PROTEINGYM_DMS_URL="${PROTEINGYM_DMS_URL:-https://marks.hms.harvard.edu/proteingym/ProteinGym_v1.3/DMS_ProteinGym_substitutions.zip}"

# Hugging Face model to pre-fetch (compute nodes often have no internet).
ESM_MODEL="${ESM_MODEL:-facebook/esm2_t33_650M_UR50D}"
